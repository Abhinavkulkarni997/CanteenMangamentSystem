generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserType {
  EMPLOYEE
  PROJECT_STAFF
  CONTRACT
  STUDENT
  INTERN
  VISITOR
}


enum SessionType {
  BREAKFAST
  LUNCH
  DINNER
}

enum OrderStatus {
  BOOKED
  COLLECTED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
}
enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id Int @id @default(autoincrement())

  name   String
  mobile String  @unique
  email  String? @unique
  gender Gender?

  password String

  employeeId  String? @unique
  projectStaffId  String? @unique
  designation String?
  division    String?
  photoUrl    String?


  projectId String?
  

  collegeName String?
  guideName String?

  contractorName String?

  organization String?


  role     Role     @default(USER)
  userType UserType

  isActive Boolean @default(true)

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deactivatedAt DateTime?
  deactivatedBy Int?

  updatedBy Int?

  forcePasswordChange Boolean @default(false)

  passwordChangedAt DateTime?
  passwordChangedBy Int?

  orders   Order[]
  scanLogs ScanLog[] @relation("AdminScanLogs")

  //wallet
  wallet Wallet?

  walletTransactions WalletTransaction[] @relation("WalletAdmin")
}

model MenuItem {
  id Int @id @default(autoincrement())

  sessionType SessionType

  itemName String

  description String?

  price Decimal @db.Decimal(10, 2)

  isAvailable Boolean @default(true)

  menuDate DateTime @db.Date

  maxQuantity Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id Int @id @default(autoincrement())

  orderNumber String? @unique

  userId Int?

  visitorName   String?
  visitorMobile String?

  totalAmount Decimal @db.Decimal(10, 2)

  transactionId String?

  paymentStatus PaymentStatus

  orderStatus OrderStatus @default(BOOKED)

  qrToken String @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  items       OrderItem[]
  collectedAt DateTime?

  scanLogs           ScanLog[]           @relation("OrderScanLogs")
  walletTransactions WalletTransaction[]
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int

  menuItemId Int

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model ScanLog {
  id Int @id @default(autoincrement())

  orderId Int
  adminId Int

  scannedAt DateTime @default(now())

  device    String?
  ipAddress String?

  order Order @relation("OrderScanLogs", fields: [orderId], references: [id])

  admin User @relation("AdminScanLogs", fields: [adminId], references: [id])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Wallet {
  id Int @id @default(autoincrement())

  userId Int @unique

  balance Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  transactions WalletTransaction[]
}

model WalletTransaction {
  id Int @id @default(autoincrement())

  walletId Int

  amount Decimal @db.Decimal(10, 2)

  type WalletTransactionType

  status WalletTransactionStatus

  remarks String?

  referenceId String?

  createdBy Int?

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  admin   User?  @relation("WalletAdmin", fields: [createdBy], references: [id])
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])
}
